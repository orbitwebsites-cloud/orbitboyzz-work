# x402 bot paywall (AI crawlers/scrapers pay per request; humans browse free)
X402_ENABLED=true
X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
X402_PRICE=$0.001
# Base mainnet (USDC)
X402_NETWORK=eip155:8453
# Coinbase CDP facilitator (required for Base mainnet). If both are set, the CDP facilitator is used.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Fallback facilitator when CDP keys are not set (x402.org only supports testnets, e.g. eip155:84532)
X402_FACILITATOR_URL=https://x402.org/facilitator
